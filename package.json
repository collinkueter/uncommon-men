{
  "name": "uncommon-men",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude 'tests/firestore*'",
    "test:rules": "vitest run tests/firestore*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "firebase": "12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^14.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
