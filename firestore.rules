rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public competition data contains display names and scores only. Authentication
    // is required for writes. Every conference lives under /conferences/{cid}.
    //
    // Roles:
    // - organizer(): the legacy custom claim admin == true, or a Google-verified
    //   email with a /platformRoles/{email} document. Organizers manage every
    //   conference, the default conference, and all roles.
    // - conferenceAdmin(cid): an organizer, or a Google-verified email with a
    //   /conferences/{cid}/admins/{email} document. Scoped to that conference.
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function short(value, size) { return value is string && value.size() > 0 && value.size() <= size; }
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) is string && request.auth.token.email.size() > 0;
    }
    function userEmail() { return request.auth.token.email.lower(); }
    function claimAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function organizer() {
      return claimAdmin()
        || (verifiedEmail() && exists(/databases/$(database)/documents/platformRoles/$(userEmail())));
    }
    function conferenceAdmin(cid) {
      return organizer()
        || (verifiedEmail() && exists(/databases/$(database)/documents/conferences/$(cid)/admins/$(userEmail())));
    }
    function validSlug(value) { return value is string && value.matches('^[a-z0-9][a-z0-9-]{1,62}$'); }
    function validEmailId(email) { return short(email, 254) && email == email.lower() && email.matches('^[^@/ ]+@[^@/ ]+$'); }
    function validDate(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Platform-level changes are audited in /platformAudit.
    function platformAudited(type, id) {
      let audit = /databases/$(database)/documents/platformAudit/$(request.resource.data.auditId);
      return short(request.resource.data.auditId, 100) && !exists(audit)
        && getAfter(audit).data.entityType == type && getAfter(audit).data.entityId == id
        && getAfter(audit).data.actorUid == request.auth.uid;
    }
    function platformTarget(data) {
      return data.entityType == 'settings'
        ? /databases/$(database)/documents/settings/$(data.entityId)
        : /databases/$(database)/documents/platformRoles/$(data.entityId);
    }
    function validPlatformAudit(auditId, data) {
      let target = platformTarget(data);
      return data.keys().hasOnly(['action', 'entityType', 'entityId', 'actorUid', 'actorName', 'at', 'before', 'after', 'reason'])
        && short(data.action, 80) && data.entityType in ['settings', 'platformRoles'] && short(data.entityId, 254)
        && data.actorUid == request.auth.uid && short(data.actorName, 254)
        && (claimAdmin() || data.actorName == request.auth.token.email)
        && data.at is timestamp && data.at == request.time && data.reason is string && data.reason.size() <= 500
        && ((getAfter(target).data.auditId == auditId && data.after == getAfter(target).data
              && ((!exists(target) && data.before == null) || (exists(target) && data.before == get(target).data)))
            || (data.entityType == 'platformRoles' && data.action == 'revokeOrganizer'
              && exists(target) && !existsAfter(target)
              && auditId == get(target).data.auditId + '-revoke'
              && data.before == get(target).data && data.after == null));
    }

    match /settings/{id} {
      allow read: if true;
      allow create, update: if id == 'platform' && organizer()
        && request.resource.data.keys().hasOnly(['defaultConferenceId', 'auditId'])
        && validSlug(request.resource.data.defaultConferenceId)
        && exists(/databases/$(database)/documents/conferences/$(request.resource.data.defaultConferenceId))
        && platformAudited('settings', id);
      allow delete: if false;
    }
    match /platformRoles/{email} {
      allow read: if organizer() || (verifiedEmail() && userEmail() == email);
      allow create, update: if organizer() && validEmailId(email)
        && request.resource.data.keys().hasOnly(['role', 'auditId'])
        && request.resource.data.role == 'organizer'
        && platformAudited('platformRoles', email);
      allow delete: if organizer()
        && getAfter(/databases/$(database)/documents/platformAudit/$(resource.data.auditId + '-revoke')).data.entityId == email;
    }
    match /platformAudit/{id} {
      allow read: if organizer();
      allow create: if signedIn() && validPlatformAudit(id, request.resource.data);
      allow update, delete: if false;
    }

    match /conferences/{cid} {
      // Draft conferences are visible only to their admins and organizers;
      // archived conferences are read-only for everyone.
      function admin() { return conferenceAdmin(cid); }
      function conferencePath() { return /databases/$(database)/documents/conferences/$(cid); }
      function readable() {
        return get(conferencePath()).data.status in ['live', 'archived'] || admin();
      }
      function writable() {
        let status = getAfter(conferencePath()).data.status;
        return status == 'live' || (status == 'draft' && admin());
      }
      function validConference(data) {
        return data.keys().hasOnly(['name', 'slug', 'startDate', 'endDate', 'location', 'status', 'createdAt', 'auditId'])
          && data.keys().hasAll(['name', 'slug', 'startDate', 'endDate', 'location', 'status', 'createdAt', 'auditId'])
          && validSlug(cid) && data.slug == cid && short(data.name, 100)
          && validDate(data.startDate) && validDate(data.endDate) && data.startDate <= data.endDate
          && data.location is string && data.location.size() <= 120
          && data.status in ['draft', 'live', 'archived'] && data.createdAt is timestamp
          && short(data.auditId, 100);
      }
      // Conference admins may edit the descriptive fields of a conference that
      // is not archived; creation and status changes are organizer-only.
      function conferenceDetailsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'startDate', 'endDate', 'location', 'auditId']);
      }

      allow read: if resource == null || resource.data.status != 'draft' || admin();
      allow create: if organizer() && validConference(request.resource.data)
        && request.resource.data.createdAt == request.time && audited('conference', cid);
      allow update: if validConference(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (organizer() || (admin() && resource.data.status != 'archived' && conferenceDetailsOnly()))
        && audited('conference', cid);
      allow delete: if false;

      function audited(type, id) {
        return short(request.resource.data.auditId, 100)
          && !exists(/databases/$(database)/documents/conferences/$(cid)/audit/$(request.resource.data.auditId))
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(request.resource.data.auditId)).data.entityType == type
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(request.resource.data.auditId)).data.entityId == id
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(request.resource.data.auditId)).data.actorUid == request.auth.uid;
      }
      function validCategory(data) {
        return data.keys().hasOnly(['name', 'group', 'order', 'auditId'])
          && short(data.name, 80) && data.group in ['physical', 'mental']
          && data.order is int && data.order >= 0 && data.order <= 1000 && short(data.auditId, 100);
      }
      function validEvent(data) {
        return data.keys().hasOnly(['categoryId', 'name', 'kind', 'direction', 'unit', 'team', 'teamSize', 'instructions', 'active', 'auditId'])
          && short(data.categoryId, 100) && short(data.name, 100)
          && data.kind in ['count', 'duration', 'distance', 'bracket', 'knockout']
          && (data.kind != 'knockout' || data.team == false)
          && data.direction in ['higher', 'lower'] && data.unit is string && data.unit.size() <= 30
          && data.team is bool && data.teamSize is int && data.teamSize >= 0 && data.teamSize <= 20
          && data.instructions is string && data.instructions.size() <= 4000
          && data.active is bool && short(data.auditId, 100);
      }
      function validParticipant(data) {
        return data.keys().hasOnly(['name', 'normalizedName', 'auditId'])
          && short(data.name, 80) && short(data.normalizedName, 80) && short(data.auditId, 100);
      }
      function renamesLinkedParticipant(id) {
        let identity = /databases/$(database)/documents/conferences/$(cid)/identities/$(request.auth.uid);
        return signedIn()
          && get(identity).data.participantId == id
          && getAfter(identity).data.participantId == id
          && getAfter(identity).data.name == request.resource.data.name
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(request.resource.data.auditId)).data.action == 'renameParticipant';
      }
      function validTeam(data) {
        return data.keys().hasOnly(['eventId', 'name', 'memberIds', 'auditId'])
          && short(data.eventId, 100) && short(data.name, 80) && data.memberIds is list
          && data.memberIds.size() <= 20 && short(data.auditId, 100);
      }
      function validTeamMembers(data) {
        let event = getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(data.eventId)).data;
        return event.team == true
          && data.memberIds.toSet().size() == data.memberIds.size()
          && (event.teamSize == 0 || data.memberIds.size() == event.teamSize)
          && (data.memberIds.size() == 0 || existsAfter(/databases/$(database)/documents/conferences/$(cid)/participants/$(data.memberIds[0])))
          && (data.memberIds.size() < 2 || existsAfter(/databases/$(database)/documents/conferences/$(cid)/participants/$(data.memberIds[1])));
      }
      function validAttempt(data) {
        return data.keys().hasOnly(['eventId', 'participantId', 'value', 'valid', 'recordedBy', 'recorderName', 'createdAt', 'updatedAt', 'revision', 'requestId', 'auditId'])
          && short(data.eventId, 100) && short(data.participantId, 100) && data.value is number
          && data.value >= 0 && data.value <= 1000000000 && data.valid is bool
          && short(data.recordedBy, 128)
          && short(data.recorderName, 80) && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.createdAt <= request.time && data.updatedAt <= request.time
          && data.revision is int && data.revision >= 1 && data.revision <= 10000
          && short(data.requestId, 100) && short(data.auditId, 100);
      }
      function validBracket(data) {
        return data.keys().hasOnly(['eventId', 'entrants', 'matches', 'status', 'revision', 'auditId', 'lastMatchIndex', 'lastParentIndex', 'entrantsOpen'])
          && short(data.eventId, 100) && data.entrants is list && data.entrants.size() <= 128
          && data.matches is list && data.matches.size() <= 255
          && ((data.status == 'registration' && data.entrants.size() >= 1 && data.matches.size() == 0)
              || (data.status in ['active', 'complete'] && data.entrants.size() >= 2 && data.matches.size() >= 1))
          && data.revision is int && data.revision >= 1 && data.revision <= 10000
          && data.get('entrantsOpen', false) is bool && short(data.auditId, 100);
      }
      // Signup appends one verified entrant. No matches or results exist until
      // an administrator explicitly starts the bracket.
      function validRegistration(data, id) {
        let event = get(/databases/$(database)/documents/conferences/$(cid)/events/$(data.eventId)).data;
        let entrant = data.entrants[data.entrants.size() - 1];
        return id == data.eventId + '-bracket'
          && event.active == true && event.kind == 'bracket'
          && data.status == 'registration' && data.matches == [] && data.entrantsOpen == true
          && !data.keys().hasAny(['lastMatchIndex', 'lastParentIndex'])
          && data.entrants.toSet().size() == data.entrants.size() && short(entrant, 100)
          && ((event.team == false && existsAfter(/databases/$(database)/documents/conferences/$(cid)/participants/$(entrant)))
              || (event.team == true && getAfter(/databases/$(database)/documents/conferences/$(cid)/teams/$(entrant)).data.eventId == data.eventId))
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(data.auditId)).data.action == 'joinBracket';
      }
      function validRegistrationAppend(data, id) {
        let entrant = data.entrants[data.entrants.size() - 1];
        return resource.data.status == 'registration' && validRegistration(data, id)
          && data.entrants.size() == resource.data.entrants.size() + 1
          && data.entrants.removeAll([entrant]) == resource.data.entrants;
      }
      function validRegistrationStart(data) {
        return admin() && resource.data.status == 'registration' && data.status == 'active'
          && data.entrants == resource.data.entrants && data.entrantsOpen == true
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(data.auditId)).data.action == 'startBracket';
      }
      function teamJoinsRegistration(data, id) {
        let event = getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(data.eventId)).data;
        let bracket = /databases/$(database)/documents/conferences/$(cid)/brackets/$(data.eventId + '-bracket');
        return event.kind != 'bracket'
          || (existsAfter(bracket) && getAfter(bracket).data.status == 'registration'
              && id in getAfter(bracket).data.entrants)
          || (admin() && exists(bracket) && get(bracket).data.status != 'registration');
      }
      // entrantsOpen is initialized by bracket creation/reseeding and closes on
      // every result write. Legacy revision-1 brackets have not recorded results.
      function validEntrantAddition(data) {
        let teamId = data.entrants[data.entrants.size() - 1];
        let event = get(/databases/$(database)/documents/conferences/$(cid)/events/$(data.eventId)).data;
        return admin() && resource.data.status == 'active' && data.status == 'active'
          && resource.data.get('entrantsOpen', resource.data.revision == 1) == true
          && data.entrantsOpen == true
          && data.entrants.size() == resource.data.entrants.size() + 1
          && data.entrants.toSet().size() == data.entrants.size()
          && data.entrants.removeAll([teamId]) == resource.data.entrants
          && short(teamId, 100) && event.kind == 'bracket'
          && ((event.team == true
                && get(/databases/$(database)/documents/conferences/$(cid)/teams/$(teamId)).data.eventId == data.eventId
                && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(data.auditId)).data.action == 'addBracketTeam')
              || (event.team == false
                && exists(/databases/$(database)/documents/conferences/$(cid)/participants/$(teamId))
                && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(data.auditId)).data.action == 'addBracketParticipant'));
      }
      function changedOnlyWinner(oldMatch, newMatch) {
        return oldMatch.winnerId == null && oldMatch.bye == false
          && oldMatch.sideA != null && oldMatch.sideB != null
          && newMatch.diff(oldMatch).affectedKeys().hasOnly(['winnerId'])
          && newMatch.winnerId in [oldMatch.sideA, oldMatch.sideB];
      }
      function validFinalWinner(data, oldMatches, newMatches, index, oldMatch, newMatch) {
        return index == oldMatches.size() - 1 && data.lastParentIndex == -1
          && data.status == 'complete'
          && oldMatches.removeAll([oldMatch]) == newMatches.removeAll([newMatch]);
      }
      function validParentAdvance(data, oldMatches, newMatches, index, oldMatch, newMatch) {
        let parentIndex = data.lastParentIndex;
        let oldParent = oldMatches[parentIndex];
        let newParent = newMatches[parentIndex];
        return index < oldMatches.size() - 1 && parentIndex > index && parentIndex < oldMatches.size()
          && oldParent.round == oldMatch.round + 1
          && oldParent.position * 2 == oldMatch.position - (oldMatch.position % 2)
          && oldParent.winnerId == null && oldParent.bye == false
          && ((oldMatch.position % 2 == 0
                && oldParent.sideA == null && newParent.sideA == newMatch.winnerId
                && newParent.diff(oldParent).affectedKeys().hasOnly(['sideA']))
              || (oldMatch.position % 2 == 1
                && oldParent.sideB == null && newParent.sideB == newMatch.winnerId
                && newParent.diff(oldParent).affectedKeys().hasOnly(['sideB'])))
          && data.status == 'active'
          && oldMatches.removeAll([oldMatch, oldParent]) == newMatches.removeAll([newMatch, newParent]);
      }
      function validWinnerAdvance(data) {
        let oldMatches = resource.data.matches;
        let newMatches = data.matches;
        let index = data.lastMatchIndex;
        let oldMatch = oldMatches[index];
        let newMatch = newMatches[index];
        return data.diff(resource.data).affectedKeys().hasOnly(['matches', 'status', 'revision', 'auditId', 'lastMatchIndex', 'lastParentIndex', 'entrantsOpen'])
          && newMatches.size() == oldMatches.size()
          && index is int && index >= 0 && index < oldMatches.size()
          && data.lastParentIndex is int
          && changedOnlyWinner(oldMatch, newMatch)
          && (validFinalWinner(data, oldMatches, newMatches, index, oldMatch, newMatch)
              || validParentAdvance(data, oldMatches, newMatches, index, oldMatch, newMatch));
      }
      function validAudit(data) {
        return data.keys().hasOnly(['action', 'entityType', 'entityId', 'actorUid', 'actorName', 'at', 'before', 'after', 'reason'])
          && short(data.action, 80)
          && data.entityType in ['categories', 'events', 'participants', 'teams', 'attempts', 'brackets', 'games', 'identities', 'conference', 'admins']
          && short(data.entityId, 128) && data.actorUid == request.auth.uid && short(data.actorName, 80)
          && data.at is timestamp && data.at == request.time && data.reason is string && data.reason.size() <= 500
          && ((data.entityType in ['conference', 'admins'] && verifiedEmail() && data.actorName == request.auth.token.email)
              || getAfter(/databases/$(database)/documents/conferences/$(cid)/identities/$(request.auth.uid)).data.name == data.actorName);
      }
      function validIdentity(data) {
        return data.keys().hasOnly(['uid', 'name', 'participantId', 'auditId'])
          && data.uid == request.auth.uid && short(data.name, 80)
          && (data.participantId == null || short(data.participantId, 128)) && short(data.auditId, 100);
      }
      // The conference document itself is audited as entityType 'conference'
      // (entityId == cid); everything else lives in a subcollection.
      function auditTarget(data) {
        return data.entityType == 'conference'
          ? /databases/$(database)/documents/conferences/$(cid)
          : /databases/$(database)/documents/conferences/$(cid)/$(data.entityType)/$(data.entityId);
      }
      function auditPointsBack(auditId, data) {
        let target = auditTarget(data);
        return (data.entityType != 'conference' || data.entityId == cid)
          && ((getAfter(target).data.auditId == auditId
                && data.after == getAfter(target).data
                && ((!exists(target) && data.before == null) || (exists(target) && data.before == get(target).data)))
              || revokesAdmin(auditId, data, target));
      }
      // Revoking a conference admin deletes the role document; its audit entry
      // id is derived from the grant's auditId so the delete rule can require it.
      function revokesAdmin(auditId, data, target) {
        return data.entityType == 'admins' && data.action == 'revokeAdmin'
          && exists(target) && !existsAfter(target)
          && auditId == get(target).data.auditId + '-revoke'
          && data.before == get(target).data && data.after == null;
      }
      function validGame(data, id) {
        let event = get(/databases/$(database)/documents/conferences/$(cid)/events/$(data.eventId)).data;
        return data.keys().hasOnly(['eventId', 'entrants', 'status', 'winnerId', 'revision', 'auditId'])
          && short(data.eventId, 100) && id == data.eventId + '-game'
          && event.kind == 'knockout' && event.team == false && event.active == true
          && data.entrants is list && data.entrants.size() >= 1 && data.entrants.size() <= 128
          && data.entrants.toSet().size() == data.entrants.size()
          && data.status in ['registration', 'active', 'complete']
          && (data.status == 'registration' || data.entrants.size() >= 2)
          && ((data.status == 'complete' && short(data.winnerId, 100) && data.winnerId in data.entrants)
              || (data.status != 'complete' && data.winnerId == null))
          && data.revision is int && data.revision >= 1 && data.revision <= 10000 && short(data.auditId, 100);
      }
      function validGameSignup(data) {
        let entrant = data.entrants[data.entrants.size() - 1];
        return data.status == 'registration' && short(entrant, 100)
          && existsAfter(/databases/$(database)/documents/conferences/$(cid)/participants/$(entrant))
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(data.auditId)).data.action == 'joinGame';
      }
      function validGameAppend(data) {
        let entrant = data.entrants[data.entrants.size() - 1];
        return resource.data.status == 'registration' && validGameSignup(data)
          && data.entrants.size() == resource.data.entrants.size() + 1
          && data.entrants.removeAll([entrant]) == resource.data.entrants;
      }
      function validGameResult(data) {
        let audit = getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(data.auditId)).data;
        return data.status == 'complete' && audit.action == 'gameWinner'
          && ((resource.data.status == 'active' && resource.data.winnerId == null)
              || (resource.data.status == 'complete' && admin() && short(audit.reason, 500)))
          && data.winnerId != resource.data.winnerId;
      }

      match /categories/{id} {
        allow read: if readable();
        allow create, update: if writable() && admin() && validCategory(request.resource.data) && audited('categories', id);
        allow delete: if false;
      }
      match /events/{id} {
        allow read: if readable();
        allow create, update: if writable() && admin() && validEvent(request.resource.data) && audited('events', id);
        allow delete: if false;
      }
      match /participants/{id} {
        allow read: if readable();
        allow create: if writable() && signedIn() && validParticipant(request.resource.data) && audited('participants', id);
        allow update: if writable() && (admin() || renamesLinkedParticipant(id))
          && validParticipant(request.resource.data) && audited('participants', id);
        allow delete: if false;
      }
      match /teams/{id} {
        allow read: if readable();
        allow create: if writable() && signedIn() && validTeam(request.resource.data) && validTeamMembers(request.resource.data)
          && teamJoinsRegistration(request.resource.data, id) && audited('teams', id);
        allow update: if writable() && admin() && validTeam(request.resource.data) && validTeamMembers(request.resource.data) && audited('teams', id);
        allow delete: if false;
      }
      match /attempts/{id} {
        allow read: if readable();
        allow create: if writable() && signedIn() && validAttempt(request.resource.data)
          && request.resource.data.recordedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/identities/$(request.auth.uid)).data.name == request.resource.data.recorderName
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.active == true
          && !(getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.kind in ['bracket', 'knockout'])
          && ((getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.team == false
                && existsAfter(/databases/$(database)/documents/conferences/$(cid)/participants/$(request.resource.data.participantId)))
              || (getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.team == true
                && existsAfter(/databases/$(database)/documents/conferences/$(cid)/teams/$(request.resource.data.participantId))))
          && (getAfter(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.kind != 'count'
              || request.resource.data.value is int)
          && request.resource.data.requestId == id && request.resource.data.revision == 1
          && request.resource.data.valid == true && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time && audited('attempts', id);
        allow update: if writable() && admin() && validAttempt(request.resource.data)
          && request.resource.data.recordedBy == resource.data.recordedBy
          && request.resource.data.recorderName == resource.data.recorderName
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.participantId == resource.data.participantId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time && audited('attempts', id);
        allow delete: if false;
      }
      match /brackets/{id} {
        allow read: if readable();
        allow create: if writable() && signedIn() && validBracket(request.resource.data)
          && get(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.kind == 'bracket'
          && ((validRegistration(request.resource.data, id)
                && request.resource.data.entrants.size() == 1 && request.resource.data.revision == 1)
              || (admin() && request.resource.data.status == 'active'))
          && audited('brackets', id);
        allow update: if writable() && signedIn() && validBracket(request.resource.data)
          && get(/databases/$(database)/documents/conferences/$(cid)/events/$(request.resource.data.eventId)).data.kind == 'bracket'
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.revision == resource.data.revision + 1
          && (validRegistrationAppend(request.resource.data, id)
              || validRegistrationStart(request.resource.data)
              || (resource.data.status in ['active', 'complete']
                && request.resource.data.status in ['active', 'complete']
                && ((request.resource.data.entrants == resource.data.entrants
                      && request.resource.data.get('entrantsOpen', false) == false
                      && (admin() || validWinnerAdvance(request.resource.data)))
                    || validEntrantAddition(request.resource.data))))
          && audited('brackets', id);
        allow delete: if false;
      }
      match /games/{id} {
        allow read: if readable();
        allow create: if writable() && signedIn() && validGame(request.resource.data, id)
          && validGameSignup(request.resource.data) && request.resource.data.entrants.size() == 1
          && request.resource.data.revision == 1 && audited('games', id);
        allow update: if writable() && signedIn() && validGame(request.resource.data, id)
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.revision == resource.data.revision + 1
          && (validGameAppend(request.resource.data)
              || (request.resource.data.entrants == resource.data.entrants
                && ((admin() && resource.data.status == 'registration' && request.resource.data.status == 'active'
                      && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(request.resource.data.auditId)).data.action == 'startGame')
                    || validGameResult(request.resource.data))))
          && audited('games', id);
        allow delete: if false;
      }
      match /audit/{id} {
        allow read: if admin();
        // Archiving (or reopening) a conference is itself audited here, so an
        // organizer's conference change is allowed whatever the status.
        allow create: if (writable() || (request.resource.data.entityType == 'conference' && organizer()))
          && signedIn() && validAudit(request.resource.data) && auditPointsBack(id, request.resource.data);
        allow update, delete: if false;
      }
      match /identities/{id} {
        allow read: if isOwner(id);
        allow create, update: if writable() && isOwner(id) && validIdentity(request.resource.data) && audited('identities', id);
        allow delete: if false;
      }
      match /admins/{email} {
        allow read: if admin() || (verifiedEmail() && userEmail() == email);
        allow create, update: if writable() && organizer() && validEmailId(email)
          && request.resource.data.keys().hasOnly(['email', 'auditId'])
          && request.resource.data.email == email && audited('admins', email);
        allow delete: if writable() && organizer()
          && getAfter(/databases/$(database)/documents/conferences/$(cid)/audit/$(resource.data.auditId + '-revoke')).data.entityId == email;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
